# Copy this file to .env.local in web-app/ when configuring integrations.
# Authentication requires APP_URL, the Supabase URL/publishable key, and ADMIN_EMAIL.
# SUPABASE_SECRET_KEY is required by notebook APIs, user management, and admin setup.
# B2 storage integration is a later step.

# Application URL: use http://localhost:3000 locally and
# https://mynotes.gnyanarushi.tech in the Vercel production environment.
# Add <APP_URL>/auth/callback and <APP_URL>/auth/callback?next=%2Freset-password
# to Supabase Authentication > URL Configuration > Redirect URLs.
APP_URL=http://localhost:3000

# Supabase public project configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only: only this verified email receives admin access.
# Use a Supabase secret key (sb_secret_...) or the legacy service_role key.
ADMIN_EMAIL=
SUPABASE_SECRET_KEY=

# Server-only: Backblaze B2 S3-compatible API settings.
# Example endpoint: https://s3.us-west-004.backblazeb2.com
B2_ENDPOINT=
B2_REGION=
B2_BUCKET_NAME=
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=

# Email delivery is configured in Supabase Auth > SMTP Settings.
# The admin login password is managed by Supabase, not an environment variable.
# An email-provider app password, when required, belongs in the SMTP settings.



